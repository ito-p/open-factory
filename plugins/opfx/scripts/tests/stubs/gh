#!/usr/bin/env bash
# gh stub for tests. Logs args to $GH_LOG; canned outputs per subcommand.
printf '%s\n' "$*" >> "${GH_LOG:-/dev/null}"
[ -n "${GH_STUB_FAIL:-}" ] && { echo "stub: gh failed" >&2; exit 1; }
[ -n "${GH_CWD_LOG:-}" ] && pwd -P >> "$GH_CWD_LOG"
case "${1:-} ${2:-}" in
  "issue comment"|"pr comment") echo "https://github.com/stub/repo/issues/1#issuecomment-1" ;;
  "pr checks") [ -n "${GH_STUB_CHECKS_OUT:-}" ] && echo "$GH_STUB_CHECKS_OUT"; exit "${GH_STUB_CHECKS_EXIT:-0}" ;;
  "label create") exit 0 ;;
  "issue view") printf '%s\n' "${GH_STUB_ISSUE_JSON:-{\}}" ;;
  "pr view") printf '%s\n' "${GH_STUB_PR_JSON:-{\}}" ;;
  "pr create") echo "https://github.com/stub/repo/pull/9" ;;
  "pr ready"|"pr edit") exit 0 ;;
  "api "*) printf '%s\n' "${GH_STUB_API_JSON:-[]}" ;;
  "auth status") exit 0 ;;
  *) exit 0 ;;
esac
